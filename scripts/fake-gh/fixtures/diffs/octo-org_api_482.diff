 import (
 	"net"
 	"net/http"
+	"strconv"
 	"sync"
 	"time"
 )
 
-// Limiter counts requests per key in a fixed window.
+// Limiter is a token bucket per key (API token, or client IP when anonymous).
 type Limiter struct {
-	mu     sync.Mutex
-	limit  int
-	window time.Duration
-	hits   map[string]*counter
+	mu      sync.Mutex
+	rate    float64 // tokens added per second
+	burst   float64
+	buckets map[string]*bucket
 }
 
-type counter struct {
-	n     int
-	start time.Time
+type bucket struct {
+	tokens float64
+	last   time.Time
 }
 
-func NewLimiter(limit int, window time.Duration) *Limiter {
-	return &Limiter{limit: limit, window: window, hits: make(map[string]*counter)}
+func NewLimiter(rps, burst float64) *Limiter {
+	return &Limiter{rate: rps, burst: burst, buckets: make(map[string]*bucket)}
 }
 
-// Allow reports whether key may proceed.
-func (l *Limiter) Allow(key string, now time.Time) bool {
+// Allow reports whether key may proceed and, if not, how long to wait.
+func (l *Limiter) Allow(key string, now time.Time) (bool, time.Duration) {
 	l.mu.Lock()
 	defer l.mu.Unlock()
 
-	c, ok := l.hits[key]
-	if !ok || now.Sub(c.start) > l.window {
-		l.hits[key] = &counter{n: 1, start: now}
-		return true
+	b, ok := l.buckets[key]
+	if !ok {
+		b = &bucket{tokens: l.burst, last: now}
+		l.buckets[key] = b
 	}
-	c.n++
-	return c.n <= l.limit
+	b.tokens += now.Sub(b.last).Seconds() * l.rate
+	if b.tokens > l.burst {
+		b.tokens = l.burst
+	}
+	b.last = now
+	if b.tokens >= 1 {
+		b.tokens--
+		return true, 0
+	}
+	return false, time.Duration((1 - b.tokens) / l.rate * float64(time.Second))
 }
 
-// RateLimit rejects requests over the limit with 429.
+// RateLimit rejects requests over the limit with 429 and a Retry-After header.
 func RateLimit(l *Limiter) func(http.Handler) http.Handler {
 	return func(next http.Handler) http.Handler {
 		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
-			key, _, _ := net.SplitHostPort(r.RemoteAddr)
-			if !l.Allow(key, time.Now()) {
+			key := r.Header.Get("X-Api-Token")
+			if key == "" {
+				key, _, _ = net.SplitHostPort(r.RemoteAddr)
+			}
+			ok, wait := l.Allow(key, time.Now())
+			if !ok {
+				w.Header().Set("Retry-After", strconv.Itoa(int(wait.Seconds())+1))
 				http.Error(w, "rate limit exceeded", http.StatusTooManyRequests)
 				return
 			}
